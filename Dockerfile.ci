# CI-only Dockerfile — copies pre-built static binaries instead of building
# from source. Used by the release workflow for multi-arch image publishing.
#
# Expected layout (prepared by the CI "docker" job):
#   dist/linux/amd64/{arcentra,arcentra-agent,arcentra-cli,conf.d/}
#   dist/linux/arm64/{arcentra,arcentra-agent,arcentra-cli,conf.d/}

# ── arcentra (control-plane) ─────────────────────────────────────────
FROM debian:bookworm-slim AS arcentra

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git bash && rm -rf /var/lib/apt/lists/*

ARG TARGETARCH
COPY dist/linux/${TARGETARCH}/arcentra /arcentra
COPY dist/linux/${TARGETARCH}/arcentra-cli /usr/local/bin/arcentra-cli
COPY dist/linux/${TARGETARCH}/conf.d/  /conf.d/

WORKDIR /var/lib/arcentra
EXPOSE 8080 9090
ENTRYPOINT ["/arcentra", "-conf", "/conf.d/config.toml", "-plugin-conf", "/conf.d/plugins.toml"]

# ── arcentra-agent ───────────────────────────────────────────────────
FROM debian:bookworm-slim AS arcentra-agent

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git bash && rm -rf /var/lib/apt/lists/*

ARG TARGETARCH
COPY dist/linux/${TARGETARCH}/arcentra-agent /arcentra-agent
COPY dist/linux/${TARGETARCH}/conf.d/        /conf.d/

WORKDIR /var/lib/arcentra
ENTRYPOINT ["/arcentra-agent", "-conf", "/conf.d/agent.toml"]
