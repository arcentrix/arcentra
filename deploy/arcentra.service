[Unit]
Description=Arcentra CI/CD Platform Server
Documentation=https://github.com/arcentrix/arcentra
After=network.target mysql.service
Wants=network.target

[Service]
Type=simple
User=arcentra
Group=arcentra
WorkingDirectory=/var/lib/arcentra
StateDirectory=arcentra
StateDirectoryMode=0700
ExecStart=/opt/arcentra/arcentra -conf /opt/arcentra/conf.d/config.toml -plugin-conf /opt/arcentra/conf.d/plugins.toml
# Configuration and TLS changes require an explicit restart; SIGHUP is not reload.
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=arcentra

# 安全设置
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/arcentra

# 资源限制
LimitNOFILE=65536
LimitNPROC=4096

# 环境变量
Environment="GOMAXPROCS=0"
Environment="TZ=Asia/Shanghai"

[Install]
WantedBy=multi-user.target
